# Local dev: postgres://postgres:devpassword@localhost:5433/lcs_dev
# Production: your Supabase project's Postgres connection string (Settings -> Database)
DATABASE_URL=

# Supabase Auth/Storage (production only — not needed for local DB-only dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HMAC signing key for the borrower portal's staff-impersonation session cookie
BORROWER_PORTAL_SESSION_SECRET=

# Helcim (borrower portal "Make Payment" — card/ACH via HelcimPay.js)
HELCIM_API_TOKEN=
# Set once the webhook is configured in the Helcim dashboard (All Tools ->
# Integrations -> Webhooks) and it hands you a signing verifierToken.
HELCIM_WEBHOOK_VERIFIER_TOKEN=

# Resend (Notices Template Builder — sending an approved Email notice)
RESEND_API_KEY=
# Address on a domain verified in Resend. Leave unset to use Resend's sandbox
# sender (onboarding@resend.dev), which only delivers to your own account.
RESEND_FROM_ADDRESS=

# Setup > Users "Send Invite" — Supabase Project Settings > API > service_role
# secret key. Bypasses RLS and can administer auth users — server-only.
SUPABASE_SERVICE_ROLE_KEY=
# This app's public URL, used to build the invite email's confirm link.
NEXT_PUBLIC_SITE_URL=

# Anthropic API — Bulk Payment check-reading, Import Land Contract document
# extraction, the in-app Help agent, Program Customization, and Notices
# Template Builder all call Claude server-side via this key.
ANTHROPIC_API_KEY=

# AssessorSearch (api.assessorsearch.com) — national property assessor/tax
# record lookup, billed per lookup against a monthly credit plan. Sent as
# the X-API-Key header, format pda_live_...
ASSESSOR_SEARCH_API_KEY=

# Google Drive (Create Land Contract Package — publishes the generated
# closing package into a Shared Drive folder). A service account's
# client_email/private_key from a Google Cloud JSON key; the target folder
# (its ID, from the folder's URL) must be shared with that service account
# email as Content Manager/Editor first. See src/lib/googleDrive.ts.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
LC_PACKAGE_DRIVE_FOLDER_ID=
